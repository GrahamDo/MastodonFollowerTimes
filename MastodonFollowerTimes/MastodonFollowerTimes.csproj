<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Graham Downs</Authors>
    <Product>Mastodon Follower Times</Product>
    <Version>1.2.0</Version>
    <Copyright>Copyright © Graham Downs 2023</Copyright>
    <ApplicationIcon>MastodonFollowerTimes Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="MastodonFollowerTimes Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENCE" Link="LICENCE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude legacy WPF window files from compilation so MAUI build doesn't try to process them -->
    <Compile Remove="MainWindow.xaml.cs" />
    <None Include="MainWindow.xaml" />
    <None Include="MainWindow.xaml.cs" />
  </ItemGroup>

</Project>
