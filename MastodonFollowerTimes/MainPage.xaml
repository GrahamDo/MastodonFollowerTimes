<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MastodonFollowerTimes"
             x:Class="MastodonFollowerTimes.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="10">
            <Label Text="Mastodon Follower Times" FontAttributes="Bold" FontSize="20"/>
            <Entry Placeholder="Instance URL" Text="{Binding Settings.InstanceUrl}" />
            <Entry Placeholder="Token" Text="{Binding Settings.Token}" />
            <Entry Placeholder="Account Name" Text="{Binding Settings.AccountName}" />
            <Button Text="Find Best Times" Clicked="FindBestTimes_Click" />
            <CollectionView ItemsSource="{Binding StatusesPerHour}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Label Text="{Binding TimeBlock}" />
                            <ProgressBar Progress="{Binding StatusCount}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
