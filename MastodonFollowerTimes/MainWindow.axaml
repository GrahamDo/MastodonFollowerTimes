<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mastodonFollowerTimes="clr-namespace:MastodonFollowerTimes"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MastodonFollowerTimes.MainWindow"
        x:DataType="mastodonFollowerTimes:MainWindowViewModel"
        Title="{Binding WindowTitle}" Height="865" Width="555">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Update Available" IsVisible="{Binding IsUpdateButtonVisible, UpdateSourceTrigger=PropertyChanged}" Click="UpdateButton_Click" />
        <Label Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Instance URL:</Label>
        <TextBox Grid.Column="1" Grid.Row="1" Margin="0,0,5,0" 
                 IsEnabled="{Binding EnableControls}"
                 Text="{Binding Settings.InstanceUrl, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <Label Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Token:</Label>
        <TextBox Grid.Column="1" Grid.Row="2" Margin="0,0,5,0" 
                 IsEnabled="{Binding EnableControls}"
                 Text="{Binding Settings.Token, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <Label Grid.Column="0" Grid.Row="3" VerticalAlignment="Center">Account Name:</Label>
        <TextBox Grid.Column="1" Grid.Row="3" Margin="0,0,5,0" 
                 IsEnabled="{Binding EnableControls}"
                 Text="{Binding Settings.AccountName, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <DockPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4">
            <Button Margin="5,5,5,0" IsDefault="True"
                    IsEnabled="{Binding EnableControls}"
                    Content="Find Best Times" HorizontalAlignment="Right" Click="ProcessButton_Click"/>
            <ProgressBar Margin="5,5,5,0"
                         IsVisible="{Binding IsInProgressVisible}" IsIndeterminate="{Binding InProgressIsIndeterminate}"
                         Value="{Binding InProgressValue}" 
                         Maximum="{Binding InProgressMaximum}"/>
        </DockPanel>
        <TreeView Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" Margin="0,5,0,0" 
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ItemsSource="{Binding StatusesPerHour}"
            IsEnabled="{Binding EnableControls}">
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="{x:Type mastodonFollowerTimes:StatusPerTimeBlock}" 
                                          ItemsSource="{Binding StatusesPerMinute}">
                    <DockPanel>
                        <Label Content="{Binding TimeBlock}" Width="24"></Label>
                        <ProgressBar Margin="0,5,0,0"
                                     Value="{Binding StatusCount}" 
                                     Maximum="{Binding ProgressBarMaximum}"
                                     
                        />
                    </DockPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>            
        </TreeView>        
    </Grid>
</Window>
