<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mastodonFollowerTimes="clr-namespace:MastodonFollowerTimes"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MastodonFollowerTimes.MainWindow"
        x:DataType="mastodonFollowerTimes:MainWindowViewModel"
        Title="{Binding WindowTitle}" Height="865" Width="555">
    Welcome to Avalonia!
</Window>
